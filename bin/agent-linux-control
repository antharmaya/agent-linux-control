#!/usr/bin/env python3
"""Linux desktop control helper for coding agents.

Targets Wayland-first desktops while keeping X11 fallbacks. The input backend
uses /dev/uinput directly so it does not depend on ydotoold being running.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import struct
import fcntl
from pathlib import Path

