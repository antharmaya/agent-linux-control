def mcp_text(payload: object, compact: bool = False) -> dict[str, object]:
    if compact:
        text = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    else:
        text = json.dumps(payload, indent=2, sort_keys=True)
    return {"content": [{"type": "text", "text": text}]}


def mcp_tool_call(name: str, arguments: dict[str, object]) -> dict[str, object]:
    brief = bool(arguments.get("brief", False))
    compact = bool(arguments.get("compact", brief))
    if name == "manifest":
        payload = brief_manifest() if brief else agent_manifest()
        return mcp_text(payload, compact=compact)
    if name == "observe":
        payload = observation(str(arguments.get("output") or "/tmp/agent-linux-control-observe.png"), bool(arguments.get("pointer", False)))
        return mcp_text(brief_observation(payload) if brief else payload, compact=compact)
    if name == "click":
        step = {"action": "click", **arguments}
        return mcp_text(run_step(step, Path("/tmp/agent-linux-control-mcp"), 0))
    if name == "type":
        step = {"action": "type", **arguments}
        return mcp_text(run_step(step, Path("/tmp/agent-linux-control-mcp"), 0))
    if name == "paste":
        paste_text(str(arguments.get("text", "")), bool(arguments.get("enter", False)))
        return mcp_text({"pasted": True})
    if name == "hotkey":
        step = {"action": "hotkey", **arguments}
        return mcp_text(run_step(step, Path("/tmp/agent-linux-control-mcp"), 0))
    if name == "browser":
        return mcp_text(launch_browser(
            str(arguments["url"]),
            str(arguments["prefer"]) if arguments.get("prefer") else None,
            bool(arguments.get("new_window", True)),
            bool(arguments.get("require_prefer", False)),
        ))
    if name == "sequence":
        steps = arguments.get("steps")
        if not isinstance(steps, list):
            raise ValueError("sequence.steps must be a list")
        output_dir = Path(str(arguments.get("output_dir") or "/tmp/agent-linux-control-sequence"))
        events = []
        for index, step in enumerate(steps):
            if not isinstance(step, dict):
                raise ValueError(f"sequence step {index} must be an object")
            events.append({"index": index, "result": run_step(step, output_dir, index)})
        payload = {"events": events}
        return mcp_text(brief_sequence(payload) if brief else payload, compact=compact)
    raise ValueError(f"unknown MCP tool: {name}")


def write_mcp(message: dict[str, object]) -> None:
    print(json.dumps(message, separators=(",", ":")), flush=True)


def mcp_cmd(args: argparse.Namespace) -> None:
    del args
    request: dict[str, object] | None = None
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            request = json.loads(line)
            method = request.get("method")
            request_id = request.get("id")
            if method == "notifications/initialized":
                continue
            if method == "initialize":
                result = {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "agent-linux-control", "version": VERSION},
                }
            elif method == "tools/list":
                result = {"tools": MCP_TOOLS}
            elif method == "tools/call":
                params = request.get("params") or {}
                if not isinstance(params, dict):
                    raise ValueError("tools/call params must be an object")
                name = str(params["name"])
                arguments = params.get("arguments") or {}
                if not isinstance(arguments, dict):
                    raise ValueError("tools/call arguments must be an object")
                result = mcp_tool_call(name, arguments)
            else:
                if request_id is None:
                    continue
                write_mcp({
                    "jsonrpc": "2.0",
                    "id": request_id,
                    "error": {"code": -32601, "message": f"method not found: {method}"},
                })
                continue
            if request_id is not None:
                write_mcp({"jsonrpc": "2.0", "id": request_id, "result": result})
        except SystemExit as exc:
            request_id = request.get("id") if isinstance(request, dict) else None
            if request_id is not None:
                message = str(exc) or "tool exited"
                write_mcp({
                    "jsonrpc": "2.0",
                    "id": request_id,
                    "error": {"code": -32000, "message": message},
                })
        except Exception as exc:  # noqa: BLE001 - protocol server must return structured errors.
            request_id = request.get("id") if isinstance(request, dict) else None
            if request_id is not None:
                write_mcp({
                    "jsonrpc": "2.0",
                    "id": request_id,
                    "error": {"code": -32000, "message": str(exc)},
                })


def main() -> None:
    parser = argparse.ArgumentParser(prog="agent-linux-control")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("manifest", help="print the agent-readable capability contract")
    p.add_argument("--compact", action="store_true", help="emit compact JSON")
    p.add_argument("--brief", action="store_true", help="emit token-minimal agent contract")
    p.set_defaults(func=manifest_cmd)

    p = sub.add_parser("doctor", help="inspect desktop-control readiness")
    p.add_argument("--json", action="store_true")
    p.add_argument("--probe", action="store_true", help="run screenshot and uinput probes")
    p.add_argument("--probe-output", default="/tmp/agent-linux-control-doctor.png")
    p.set_defaults(func=doctor)

    p = sub.add_parser("screenshot", help="capture the screen")
    p.add_argument("--output", "-o", default="/tmp/agent-linux-control-screen.png")
    p.add_argument("--pointer", action="store_true")
    p.set_defaults(func=screenshot)

    p = sub.add_parser("observe", help="capture screen plus agent-ready metadata as JSON")
    p.add_argument("--output", "-o", default="/tmp/agent-linux-control-observe.png")
    p.add_argument("--pointer", action="store_true")
    p.add_argument("--compact", action="store_true", help="emit compact JSON")
    p.add_argument("--brief", action="store_true", help="emit token-minimal JSON")
    p.set_defaults(func=observe)

    p = sub.add_parser("watch", help="capture repeated observations as JSONL")
    p.add_argument("--output-dir", default="/tmp/agent-linux-control-watch")
    p.add_argument("--prefix", default="frame")
    p.add_argument("--interval", type=float, default=1.0)
    p.add_argument("--count", type=int, default=5, help="number of frames; 0 means until interrupted")
    p.add_argument("--pointer", action="store_true")
    p.add_argument("--brief", action="store_true", help="emit token-minimal JSONL")
    p.set_defaults(func=watch)

    p = sub.add_parser("wait-change", help="wait until the visible screen changes")
    p.add_argument("--output", "-o", default="/tmp/agent-linux-control-change.png")
    p.add_argument("--timeout", type=float, default=10.0)
    p.add_argument("--interval", type=float, default=0.5)
    p.add_argument("--pointer", action="store_true")
    p.add_argument("--compact", action="store_true", help="emit compact JSON")
    p.add_argument("--brief", action="store_true", help="emit token-minimal JSON")
    p.set_defaults(func=wait_cmd)

    p = sub.add_parser("journal", help="inspect the privacy-safe event journal")
    journal_sub = p.add_subparsers(dest="journal_command", required=True)
    jp = journal_sub.add_parser("path", help="print journal path")
    jp.set_defaults(func=journal_cmd)
    jt = journal_sub.add_parser("tail", help="print recent journal events")
    jt.add_argument("--lines", type=int, default=20)
    jt.set_defaults(func=journal_cmd)

    p = sub.add_parser("brain", help="export agent brain maps for Obsidian")
    brain_sub = p.add_subparsers(dest="brain_command", required=True)
    bp = brain_sub.add_parser("export", help="write an Obsidian-compatible vault")
    bp.add_argument("--output-dir", default="./agent-linux-control-vault")
    bp.add_argument("--compact", action="store_true", help="emit compact JSON")
    bp.set_defaults(func=brain_cmd)

    p = sub.add_parser("bench", help="benchmark perception and input control loops")
    bench_sub = p.add_subparsers(dest="bench_command", required=True)
    bo = bench_sub.add_parser("observe", help="measure screenshot observation latency")
    bo.add_argument("--count", type=int, default=5)
    bo.add_argument("--output-dir", default="/tmp/agent-linux-control-bench")
    bo.add_argument("--pointer", action="store_true")
    bo.add_argument("--compact", action="store_true", help="emit compact JSON")
    bo.add_argument("--brief", action="store_true", help="emit brief run payloads")
    bo.set_defaults(func=bench_cmd)
    bu = bench_sub.add_parser("uinput", help="measure uinput setup plus small pointer move latency")
    bu.add_argument("--count", type=int, default=3)
    bu.add_argument("--dx", type=int, default=1)
    bu.add_argument("--dy", type=int, default=1)
    bu.add_argument("--compact", action="store_true", help="emit compact JSON")
    bu.add_argument("--brief", action="store_true", help="emit compact JSON")
    bu.set_defaults(func=bench_cmd)

    p = sub.add_parser("move", help="move pointer by relative pixels")
    p.add_argument("dx", type=int)
    p.add_argument("dy", type=int)
    p.set_defaults(func=lambda a: uinput_action(lambda ui: ui.move(a.dx, a.dy)))

    p = sub.add_parser("goto", help="move pointer to approximate absolute screen coordinates")
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)
    p.set_defaults(func=lambda a: uinput_action(lambda ui: ui.goto(a.x, a.y)))

    p = sub.add_parser("click", help="click a mouse button, optionally at coordinates")
    p.add_argument("button", choices=sorted(BUTTONS), nargs="?", default="left")
    p.add_argument("--x", type=int)
    p.add_argument("--y", type=int)
    def do_click(a: argparse.Namespace) -> None:
        try:
            xy = validate_optional_xy(a.x, a.y)
        except ValueError as exc:
            raise SystemExit(str(exc))

        def action(ui: UInput) -> None:
            if xy:
                ui.goto(*xy)
                time.sleep(0.05)
            ui.click(a.button)
        uinput_action(action)
    p.set_defaults(func=do_click)

    p = sub.add_parser("scroll", help="scroll vertically and optionally horizontally")
    p.add_argument("vertical", type=int)
    p.add_argument("horizontal", type=int, nargs="?", default=0)
    p.set_defaults(func=lambda a: uinput_action(lambda ui: ui.scroll(a.vertical, a.horizontal)))

    p = sub.add_parser("key", help="press and release a named key")
    p.add_argument("name")
    p.set_defaults(func=lambda a: uinput_action(lambda ui: ui.tap(key_code(a.name))))

    p = sub.add_parser("hotkey", help="press a key chord such as ctrl+l or alt+tab")
    p.add_argument("chord")
    p.set_defaults(func=lambda a: uinput_action(lambda ui: ui.hotkey([key_code(x) for x in a.chord.split("+") if x])))

    p = sub.add_parser("type", help="type ASCII text")
    p.add_argument("text")
    p.set_defaults(func=lambda a: uinput_action(lambda ui: ui.type_text(a.text)))

    p = sub.add_parser("paste", help="set clipboard and paste text with Ctrl+V")
    p.add_argument("text", nargs="?")
    p.add_argument("--file")
    p.add_argument("--enter", action="store_true", help="press Enter after paste")
    p.set_defaults(func=paste_cmd)

    p = sub.add_parser("clipboard", help="get or set clipboard text")
    clip_sub = p.add_subparsers(dest="clipboard_command", required=True)
    cp = clip_sub.add_parser("set")
    cp.add_argument("text", nargs="?")
    cp.add_argument("--file")
    cp.set_defaults(func=lambda a: clipboard_set(read_text_arg(a.text, a.file)))
    cp = clip_sub.add_parser("get")
    cp.set_defaults(func=lambda a: clipboard_get())

    p = sub.add_parser("open", help="open a URL or file with xdg-open")
    p.add_argument("target")
    p.set_defaults(func=lambda a: subprocess.Popen(["xdg-open", a.target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))

    p = sub.add_parser("browser", help="launch a supported browser at a URL")
    p.add_argument("url")
    p.add_argument("--prefer", help="preferred browser alias or command, e.g. chrome, chromium, zen")
    p.add_argument("--require-prefer", action="store_true", help="fail instead of falling back when --prefer is unavailable")
    p.add_argument("--same-window", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=browser_cmd)

    p = sub.add_parser("sequence", help="run a JSON batch of actions and observations")
    p.add_argument("--file", "-f", default="-", help="JSON file path, or - for stdin")
    p.add_argument("--output-dir", default="/tmp/agent-linux-control-sequence")
    p.add_argument("--continue-on-error", action="store_true")
    p.add_argument("--compact", action="store_true", help="emit compact JSON")
    p.add_argument("--brief", action="store_true", help="emit token-minimal result JSON")
    p.set_defaults(func=sequence_cmd)

    p = sub.add_parser("mcp", help="run a small stdio MCP server for desktop-control tools")
    p.set_defaults(func=mcp_cmd)

    args = parser.parse_args()
    result = args.func(args)
    if isinstance(result, subprocess.Popen):
        print(f"opened: {args.target}")


if __name__ == "__main__":
    main()
