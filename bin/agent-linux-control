def ioctl_iow(type_char: str, number: int, size: int) -> int:
    ioc_nrbits = 8
    ioc_typebits = 8
    ioc_sizebits = 14
    ioc_nrshift = 0
    ioc_typeshift = ioc_nrshift + ioc_nrbits
    ioc_sizeshift = ioc_typeshift + ioc_typebits
    ioc_dirshift = ioc_sizeshift + ioc_sizebits
    ioc_write = 1
    return (
        (ioc_write << ioc_dirshift)
        | (size << ioc_sizeshift)
        | (ord(type_char) << ioc_typeshift)
        | (number << ioc_nrshift)
    )


UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
UI_DEV_SETUP = ioctl_iow("U", 3, struct.calcsize("HHHH80sI"))
UI_SET_EVBIT = ioctl_iow("U", 100, struct.calcsize("i"))
UI_SET_KEYBIT = ioctl_iow("U", 101, struct.calcsize("i"))
UI_SET_RELBIT = ioctl_iow("U", 102, struct.calcsize("i"))


class UInput:
    def __init__(self) -> None:
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        self.created = False
        self._setup()

    def _setbit(self, request: int, value: int) -> None:
        fcntl.ioctl(self.fd, request, value)

    def _setup(self) -> None:
        self._setbit(UI_SET_EVBIT, EV_KEY)
        self._setbit(UI_SET_EVBIT, EV_REL)
        for code in (REL_X, REL_Y, REL_WHEEL, REL_HWHEEL):
            self._setbit(UI_SET_RELBIT, code)
        key_codes = set(BUTTONS.values())
        key_codes.update(KEYS.values())
        key_codes.update(NAMED_KEYS.values())
        key_codes.update((KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_LEFTALT, KEY_LEFTMETA))
        for code in sorted(key_codes):
            self._setbit(UI_SET_KEYBIT, code)
        name = b"agent-linux-control"
        setup = struct.pack("HHHH80sI", BUS_USB, 0x4C43, 0x0001, 0x0001, name, 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        self.created = True
        time.sleep(float(os.environ.get("AGENT_LINUX_CONTROL_DEVICE_DELAY", "0.65")))

    def event(self, ev_type: int, code: int, value: int) -> None:
        os.write(self.fd, struct.pack("llHHi", 0, 0, ev_type, code, value))

    def sync(self) -> None:
        self.event(EV_SYN, SYN_REPORT, 0)

    def move(self, dx: int, dy: int) -> None:
        if dx:
            self.event(EV_REL, REL_X, dx)
        if dy:
            self.event(EV_REL, REL_Y, dy)
        self.sync()

    def goto(self, x: int, y: int) -> None:
        self.move(-100000, -100000)
        time.sleep(0.05)
        self.move(x, y)

    def scroll(self, vertical: int, horizontal: int = 0) -> None:
        if vertical:
            self.event(EV_REL, REL_WHEEL, vertical)
        if horizontal:
            self.event(EV_REL, REL_HWHEEL, horizontal)
        self.sync()

    def key(self, code: int, down: bool) -> None:
        self.event(EV_KEY, code, 1 if down else 0)
        self.sync()

    def tap(self, code: int) -> None:
        self.key(code, True)
        time.sleep(0.03)
        self.key(code, False)

    def click(self, button: str) -> None:
        self.tap(BUTTONS[button])

    def hotkey(self, keys: list[int]) -> None:
        if not keys:
            return
        for code in keys[:-1]:
            self.key(code, True)
            time.sleep(0.02)
        self.tap(keys[-1])
        for code in reversed(keys[:-1]):
            self.key(code, False)
            time.sleep(0.02)

    def type_text(self, text: str) -> None:
        for ch in text:
            shift = False
            key_char = ch
            if "A" <= ch <= "Z":
                shift = True
                key_char = ch.lower()
            elif ch in SHIFTED:
                shift = True
                key_char = SHIFTED[ch]
            code = KEYS.get(key_char)
            if code is None:
                raise SystemExit(f"unsupported character for typing: {ch!r}")
            if shift:
                self.key(KEY_LEFTSHIFT, True)
            self.tap(code)
            if shift:
                self.key(KEY_LEFTSHIFT, False)
            time.sleep(0.015)

    def close(self) -> None:
        if self.created:
            time.sleep(0.15)
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
            self.created = False
        os.close(self.fd)

    def __enter__(self) -> "UInput":
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        self.close()


def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)


def have(name: str) -> bool:
    return shutil.which(name) is not None


def session_type() -> str:
    return os.environ.get("XDG_SESSION_TYPE", "")


def desktop() -> str:
    return os.environ.get("XDG_CURRENT_DESKTOP", "")


def package_manager() -> str | None:
    for name in ("dnf", "apt-get", "pacman", "zypper", "apk", "yum"):
        if have(name):
            return name
    return None


def stdout_json(payload: object, pretty: bool = True) -> None:
    if pretty:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(json.dumps(payload, sort_keys=True))


def emit_json(payload: object, compact: bool = False, brief: bool = False) -> None:
    stdout_json(payload, pretty=not (compact or brief))


def now_ms() -> int:
    return int(time.time() * 1000)


def benchmark_summary(samples: list[float]) -> dict[str, object]:
    if not samples:
        return {
            "count": 0,
            "min_ms": None,
            "max_ms": None,
            "avg_ms": None,
        }
    return {
        "count": len(samples),
        "min_ms": round(min(samples), 2),
        "max_ms": round(max(samples), 2),
        "avg_ms": round(sum(samples) / len(samples), 2),
    }


def default_journal_path() -> Path:
    configured = os.environ.get("AGENT_LINUX_CONTROL_JOURNAL")
    if configured:
        return Path(configured).expanduser()
    state_home = Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser()
    return state_home / "agent-linux-control" / "events.jsonl"


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sanitize_for_journal(value: object) -> object:
    if isinstance(value, dict):
        sanitized: dict[str, object] = {}
        for key, child in value.items():
            key_lc = str(key).lower()
            if key_lc in {"text", "password", "secret", "token", "clipboard"} and isinstance(child, str):
                sanitized[f"{key}_length"] = len(child)
                sanitized[f"{key}_sha256"] = sha256_text(child)
            else:
                sanitized[str(key)] = sanitize_for_journal(child)
        return sanitized
    if isinstance(value, list):
        return [sanitize_for_journal(item) for item in value]
    return value


def journal_event(event_type: str, payload: dict[str, object]) -> None:
    if os.environ.get("AGENT_LINUX_CONTROL_NO_JOURNAL") == "1":
        return
    event = {
        "timestamp_ms": now_ms(),
        "version": VERSION,
        "event": event_type,
        "payload": sanitize_for_journal(payload),
    }
    try:
        path = default_journal_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
    except OSError:
        return


def agent_manifest() -> dict[str, object]:
    return {
        "name": "agent-linux-control",
        "version": VERSION,
        "mission": "Linux agent control substrate for perception, actuation, verification, and workflow integration.",
        "principles": [
            "Observe before acting.",
            "Prefer app-native or DOM automation before OS-level control.",
            "Use paste for long text and sequence for known multi-step plans.",
            "Verify visible state after important UI actions.",
            "Never enter secrets, approve elevated prompts, submit payments, or delete data without explicit user approval.",
        ],
        "recommended_loop": [
            "doctor",
            "observe",
            "plan one action or sequence",
            "act",
            "wait-change or observe",
            "journal outcome",
        ],
        "journal": {
            "enabled_by_default": os.environ.get("AGENT_LINUX_CONTROL_NO_JOURNAL") != "1",
            "path": str(default_journal_path()),
            "redaction": "Text-like fields are stored as length and sha256, not raw content.",
        },
        "obsidian": {
            "export_command": "agent-linux-control brain export --output-dir ./agent-linux-control-vault",
            "purpose": "Create a local graph of capabilities, workflows, validations, and integration recipes.",
        },
        "capabilities": CAPABILITIES,
    }


def brief_manifest(manifest: dict[str, object] | None = None) -> dict[str, object]:
    source = manifest or agent_manifest()
    caps = [
        [item["name"], "r" if item["read_only"] else "w", item["risk"]]
        for item in source["capabilities"]  # type: ignore[index]
    ]
    return {
        "v": source["version"],
        "loop": ["doctor", "observe", "act", "verify"],
        "caps": caps,
        "journal": source["journal"]["path"],  # type: ignore[index]
        "obsidian": "agent-linux-control brain export --output-dir ./agent-linux-control-vault",
    }


def manifest_cmd(args: argparse.Namespace) -> None:
    payload = brief_manifest() if args.brief else agent_manifest()
    emit_json(payload, compact=args.compact, brief=args.brief)


def png_size(path: Path) -> tuple[int | None, int | None]:
    try:
        with path.open("rb") as fh:
            header = fh.read(24)
        if header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
            return None, None
        width, height = struct.unpack(">II", header[16:24])
        return width, height
    except OSError:
        return None, None


def screenshot_summary(path: Path) -> dict[str, object]:
    width, height = png_size(path)
    stat = path.stat()
    return {
        "path": str(path),
        "bytes": stat.st_size,
        "width": width,
        "height": height,
        "sha256": sha256_file(path),
        "mtime_ms": int(stat.st_mtime * 1000),
    }


def tool_checks() -> dict[str, bool]:
    return {
        name: have(name)
        for name in [
            "spectacle", "grim", "gnome-screenshot", "scrot", "maim", "import",
            "ydotool", "wtype", "wl-copy", "wl-paste", "xclip", "xsel", "qdbus",
        ]
    }


def desktop_state() -> dict[str, object]:
    return {
        "session_type": session_type() or None,
        "desktop": desktop() or None,
        "display": os.environ.get("DISPLAY"),
        "wayland_display": os.environ.get("WAYLAND_DISPLAY"),
        "package_manager": package_manager(),
        "uinput_exists": Path("/dev/uinput").exists(),
        "uinput_readable": os.access("/dev/uinput", os.R_OK),
        "uinput_writable": os.access("/dev/uinput", os.W_OK),
    }


def screenshot_commands(output: str, pointer: bool = False) -> list[list[str]]:
    commands: list[list[str]] = []
    if session_type() == "wayland" and have("grim") and not pointer:
        commands.append(["grim", output])
    if have("spectacle"):
        cmd = ["spectacle", "-b", "-n", "-o", output]
        if pointer:
            cmd.insert(3, "-p")
        commands.append(cmd)
    if session_type() == "wayland" and have("grim") and pointer:
        commands.append(["grim", output])
    if have("gnome-screenshot"):
        commands.append(["gnome-screenshot", "-f", output])
    if have("scrot"):
        commands.append(["scrot", output])
    if have("maim"):
        commands.append(["maim", output])
    if have("import") and os.environ.get("DISPLAY"):
        commands.append(["import", "-window", "root", output])
    return commands


def capture_screenshot(output: str, pointer: bool = False) -> Path:
    out = Path(output).expanduser().resolve()
    out.parent.mkdir(parents=True, exist_ok=True)
    commands = screenshot_commands(str(out), pointer)
    errors: list[str] = []
    for cmd in commands:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if proc.returncode == 0 and out.exists() and out.stat().st_size > 0:
            return out
        errors.append(f"{cmd[0]}: {proc.stderr.strip() or proc.stdout.strip() or proc.returncode}")
    raise SystemExit("screenshot failed; tried: " + "; ".join(errors or ["no screenshot tools found"]))


def screenshot(args: argparse.Namespace) -> None:
    print(str(capture_screenshot(args.output, args.pointer)))


def observation(output: str, pointer: bool = False) -> dict[str, object]:
    started = now_ms()
    path = capture_screenshot(output, pointer)
    return {
        "version": VERSION,
        "timestamp_ms": now_ms(),
        "duration_ms": now_ms() - started,
        "desktop": desktop_state(),
        "tools": tool_checks(),
        "screenshot": screenshot_summary(path),
    }


def brief_observation(payload: dict[str, object]) -> dict[str, object]:
    desktop_info = payload.get("desktop", {})
    screenshot_info = payload.get("screenshot", {})
    if not isinstance(desktop_info, dict):
        desktop_info = {}
    if not isinstance(screenshot_info, dict):
        screenshot_info = {}
    width = screenshot_info.get("width")
    height = screenshot_info.get("height")
    sha = str(screenshot_info.get("sha256", ""))
    if desktop_info.get("uinput_writable"):
        uinput = "rw"
    elif desktop_info.get("uinput_readable"):
        uinput = "ro"
    elif desktop_info.get("uinput_exists"):
        uinput = "no-write"
    else:
        uinput = "missing"
    return {
        "v": payload.get("version"),
        "ms": payload.get("duration_ms"),
        "desk": f"{desktop_info.get('session_type') or '?'}:{desktop_info.get('desktop') or '?'}",
        "uinput": uinput,
        "shot": screenshot_info.get("path"),
        "size": f"{width}x{height}",
        "bytes": screenshot_info.get("bytes"),
        "sha": sha[:12],
    }


def brief_wait_change(payload: dict[str, object]) -> dict[str, object]:
    screenshot_info = payload.get("screenshot", {})
    if not isinstance(screenshot_info, dict):
        screenshot_info = {}
    width = screenshot_info.get("width")
    height = screenshot_info.get("height")
    return {
        "changed": payload.get("changed"),
        "tries": payload.get("attempts"),
        "ms": payload.get("duration_ms"),
        "shot": screenshot_info.get("path"),
        "size": f"{width}x{height}",
        "sha": str(screenshot_info.get("sha256", ""))[:12],
    }


def brief_sequence(payload: dict[str, object]) -> dict[str, object]:
    events = []
    for event in payload.get("events", []):
        if not isinstance(event, dict):
            continue
        item: dict[str, object] = {
            "i": event.get("index"),
            "a": event.get("action"),
            "ok": event.get("ok"),
            "ms": event.get("duration_ms"),
        }
        if event.get("error"):
            item["err"] = event["error"]
        result = event.get("result")
        if isinstance(result, dict):
            if "screenshot" in result and isinstance(result["screenshot"], dict):
                shot = result["screenshot"]
                item["shot"] = shot.get("path")
            elif "screenshot" in result:
                item["result"] = result["screenshot"]
            elif "path" in result:
                item["path"] = result["path"]
            elif "browser" in result:
                item["browser"] = result.get("browser")
                item["pid"] = result.get("pid")
            elif "changed" in result:
                item["changed"] = result.get("changed")
        events.append(item)
    return {"ok": payload.get("ok"), "events": events}


def observe(args: argparse.Namespace) -> None:
    payload = observation(args.output, args.pointer)
    journal_event("observe", payload)
    output = brief_observation(payload) if args.brief else payload
    emit_json(output, compact=args.compact, brief=args.brief)


def watch(args: argparse.Namespace) -> None:
    out_dir = Path(args.output_dir).expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    previous_hash: str | None = None
    index = 0
    try:
        while args.count == 0 or index < args.count:
            out = out_dir / f"{args.prefix}-{index:04d}.png"
            payload = observation(str(out), args.pointer)
            current_hash = str(payload["screenshot"]["sha256"])  # type: ignore[index]
            payload["index"] = index
            payload["changed"] = previous_hash is not None and current_hash != previous_hash
            journal_event("watch.frame", payload)
            output = brief_observation(payload) if args.brief else payload
            print(json.dumps(output, sort_keys=True, separators=(",", ":") if args.brief else None), flush=True)
            previous_hash = current_hash
            index += 1
            if args.count == 0 or index < args.count:
                time.sleep(args.interval)
    except KeyboardInterrupt:
        return


def wait_change(timeout: float, interval: float, output: str, pointer: bool = False) -> dict[str, object]:
    start = time.time()
    baseline_path = Path(output).expanduser().resolve().with_suffix(".baseline.png")
    baseline = capture_screenshot(str(baseline_path), pointer)
    baseline_summary = screenshot_summary(baseline)
    attempts = 0
    while time.time() - start < timeout:
        time.sleep(interval)
        attempts += 1
        current = capture_screenshot(output, pointer)
        current_summary = screenshot_summary(current)
        if current_summary["sha256"] != baseline_summary["sha256"]:
            return {
                "changed": True,
                "attempts": attempts,
                "duration_ms": int((time.time() - start) * 1000),
                "baseline": baseline_summary,
                "screenshot": current_summary,
            }
    current = capture_screenshot(output, pointer)
    return {
        "changed": False,
        "attempts": attempts,
        "duration_ms": int((time.time() - start) * 1000),
        "baseline": baseline_summary,
        "screenshot": screenshot_summary(current),
    }


def wait_cmd(args: argparse.Namespace) -> None:
    payload = wait_change(args.timeout, args.interval, args.output, args.pointer)
    journal_event("wait-change", payload)
    output = brief_wait_change(payload) if args.brief else payload
    emit_json(output, compact=args.compact, brief=args.brief)


def journal_cmd(args: argparse.Namespace) -> None:
    path = default_journal_path()
    if args.journal_command == "path":
        print(str(path))
        return
    if args.journal_command == "tail":
        if not path.exists():
            return
        lines = path.read_text(encoding="utf-8").splitlines()
        for line in lines[-args.lines:]:
            print(line)


def obsidian_node_names() -> list[str]:
    return [
        "Agent Linux Control.md",
        "Capabilities.md",
        "Agent Loop.md",
        "Validation Matrix.md",
        "Security Model.md",
        "Integrations.md",
    ]


def obsidian_nodes() -> dict[str, str]:
    manifest = agent_manifest()
    capability_lines = [
        f"- [[{item['name']}]] - {item['kind']} - risk: `{item['risk']}` - read only: `{item['read_only']}`"
        for item in CAPABILITIES
    ]
    tool_nodes = {
        f"tools/{item['name']}.md": (
            f"# {item['name']}\n\n"
            f"Kind: `{item['kind']}`\n\n"
            f"Risk: `{item['risk']}`\n\n"
            f"Read only: `{item['read_only']}`\n\n"
            f"{item['description']}\n\n"
            "Backlinks: [[Capabilities]] [[Agent Loop]]\n"
        )
        for item in CAPABILITIES
    }
    nodes = {
        "Agent Linux Control.md": (
            "# Agent Linux Control\n\n"
            "Linux agent-control substrate for [[Capabilities]], [[Agent Loop]], [[Security Model]], "
            "[[Validation Matrix]], and [[Integrations]].\n\n"
            f"Version: `{VERSION}`\n\n"
            f"Journal: `{manifest['journal']['path']}`\n"
        ),
        "Capabilities.md": "# Capabilities\n\n" + "\n".join(capability_lines) + "\n",
        "Agent Loop.md": (
            "# Agent Loop\n\n"
            "1. [[doctor]]\n"
            "2. [[observe]]\n"
            "3. Plan one action or [[sequence]]\n"
            "4. Act through [[click]], [[paste]], [[browser]], or keyboard tools\n"
            "5. Verify with [[wait-change]] or [[observe]]\n"
            "6. Review [[Validation Matrix]] and journal outcomes\n"
        ),
        "Validation Matrix.md": (
            "# Validation Matrix\n\n"
            "| Layer | Validation |\n"
            "|---|---|\n"
            "| Install | `AGENT_LINUX_CONTROL_NO_DEPS=1 AGENT_LINUX_CONTROL_SOURCE_DIR=\"$PWD\" ./install.sh` |\n"
            "| Syntax | `python3 -m py_compile bin/agent-linux-control` |\n"
            "| Unit | `python3 -m unittest tests/test_agent_linux_control.py` |\n"
            "| Runtime | `./scripts/smoke.sh` |\n"
            "| Perception | `agent-linux-control observe --output /tmp/alc.png` |\n"
            "| MCP | `printf ... | agent-linux-control mcp` |\n"
        ),
        "Security Model.md": (
            "# Security Model\n\n"
            "- OS-level control is powerful and must be treated as a privileged actuator.\n"
            "- Raw text-like payloads are redacted in the journal.\n"
            "- Agents must not enter secrets, approve elevated prompts, submit payments, or delete data without explicit approval.\n"
            "- Prefer read-only observation before mutation.\n"
            "- Prefer strict browser selection with `--require-prefer` when target browser matters.\n"
        ),
        "Integrations.md": (
            "# Integrations\n\n"
            "- Codex: skill plus optional MCP stdio server.\n"
            "- Claude Code: skill, MCP config, and hook-compatible command surfaces.\n"
            "- Gemini/OpenCode/Qwen/Goose/Windsurf: portable skill plus shell command surface.\n"
            "- Obsidian: this vault export for graphing capabilities, workflows, and validation evidence.\n"
        ),
    }
    nodes.update(tool_nodes)
    return nodes


def export_obsidian(output_dir: str) -> dict[str, object]:
    root = Path(output_dir).expanduser().resolve()
    written: list[str] = []
    for rel_path, content in obsidian_nodes().items():
        path = root / rel_path
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        written.append(str(path))
    journal_event("brain.export", {"output_dir": str(root), "files": written})
    return {"output_dir": str(root), "files": written}


def brain_cmd(args: argparse.Namespace) -> None:
    if args.brain_command == "export":
        stdout_json(export_obsidian(args.output_dir), pretty=not args.compact)


def bench_observe(args: argparse.Namespace) -> dict[str, object]:
    out_dir = Path(args.output_dir).expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    wall_samples: list[float] = []
    cli_samples: list[float] = []
    runs: list[dict[str, object]] = []
    for index in range(args.count):
        output = out_dir / f"observe-{index:03d}.png"
        started = time.perf_counter()
        payload = observation(str(output), args.pointer)
        wall_ms = (time.perf_counter() - started) * 1000
        wall_samples.append(wall_ms)
        cli_samples.append(float(payload["duration_ms"]))
        item = brief_observation(payload) if args.brief else payload
        if isinstance(item, dict):
            item["i"] = index
            item["wall_ms"] = round(wall_ms, 2)
        runs.append(item)
    return {
        "bench": "observe",
        "version": VERSION,
        "count": args.count,
        "wall": benchmark_summary(wall_samples),
        "cli": benchmark_summary(cli_samples),
        "runs": runs,
    }


def bench_uinput(args: argparse.Namespace) -> dict[str, object]:
    samples: list[float] = []
    runs: list[dict[str, object]] = []
    for index in range(args.count):
        started = time.perf_counter()
        uinput_action(lambda ui: ui.move(args.dx, args.dy))
        wall_ms = (time.perf_counter() - started) * 1000
        samples.append(wall_ms)
        runs.append({"i": index, "wall_ms": round(wall_ms, 2)})
    return {
        "bench": "uinput",
        "version": VERSION,
        "count": args.count,
        "wall": benchmark_summary(samples),
        "runs": runs,
    }


def bench_cmd(args: argparse.Namespace) -> None:
    if args.bench_command == "observe":
        payload = bench_observe(args)
    elif args.bench_command == "uinput":
        payload = bench_uinput(args)
    else:
        raise SystemExit(f"unknown bench command: {args.bench_command}")
    emit_json(payload, compact=args.compact, brief=args.brief)
    journal_event("bench", payload)


def clipboard_set(text: str) -> None:
    if session_type() == "wayland" and have("wl-copy"):
        subprocess.run(["wl-copy"], input=text, text=True, check=True)
        return
    if have("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard"], input=text, text=True, check=True)
        return
    if have("xsel"):
        subprocess.run(["xsel", "--clipboard", "--input"], input=text, text=True, check=True)
        return
    raise SystemExit("no clipboard setter found; install wl-clipboard or xclip")


def clipboard_get() -> None:
    if session_type() == "wayland" and have("wl-paste"):
        print(run(["wl-paste"], check=False).stdout, end="")
        return
    if have("xclip"):
        print(run(["xclip", "-selection", "clipboard", "-o"], check=False).stdout, end="")
        return
    if have("xsel"):
        print(run(["xsel", "--clipboard", "--output"], check=False).stdout, end="")
        return
    raise SystemExit("no clipboard getter found; install wl-clipboard or xclip")


def read_text_arg(text: str | None, file_path: str | None) -> str:
    if file_path:
        return Path(file_path).expanduser().read_text()
    if text is not None:
        return text
    return sys.stdin.read()


def text_from_step(step: dict[str, object]) -> str:
    if step.get("file"):
        return Path(str(step["file"])).expanduser().read_text()
    return str(step.get("text", ""))


def validate_optional_xy(x: object | None, y: object | None) -> tuple[int, int] | None:
    if (x is None) != (y is None):
        raise ValueError("x and y must be provided together")
    if x is None:
        return None
    return int(x), int(y)


def step_action(step: dict[str, object]) -> str:
    return str(step.get("action") or step.get("type") or "").lower()


def is_input_step(step: dict[str, object]) -> bool:
    return step_action(step) in INPUT_ACTIONS


def key_code(name: str) -> int:
    key = name.lower()
    if key in NAMED_KEYS:
        return NAMED_KEYS[key]
    if key in KEYS:
        return KEYS[key]
    raise SystemExit(f"unknown key: {name}")


def uinput_action(action) -> None:
    try:
        with UInput() as ui:
            action(ui)
    except PermissionError:
        raise SystemExit("permission denied opening /dev/uinput; run installer or add uaccess udev rule")
    except FileNotFoundError:
        raise SystemExit("/dev/uinput not found; load the uinput kernel module")


def paste_text(text: str, enter: bool = False) -> None:
    clipboard_set(text)

    def action(ui: UInput) -> None:
        ui.hotkey([KEY_LEFTCTRL, key_code("v")])
        if enter:
            time.sleep(0.05)
            ui.tap(KEY_ENTER)

    uinput_action(action)


def paste_cmd(args: argparse.Namespace) -> None:
    paste_text(read_text_arg(args.text, args.file), args.enter)


def browser_matches(prefer: str | None, require: bool = False) -> list[tuple[str, str]]:
    if not prefer:
        return BROWSER_CANDIDATES
    prefer_lc = prefer.lower()
    preferred: list[tuple[str, str]] = []
    rest: list[tuple[str, str]] = []
    for alias, command in BROWSER_CANDIDATES:
        if prefer_lc in (alias, command.lower()):
            preferred.append((alias, command))
        else:
            rest.append((alias, command))
    if shutil.which(prefer):
        preferred.insert(0, (prefer_lc, prefer))
    return preferred if require else preferred + rest


def find_browser(prefer: str | None = None, require: bool = False) -> tuple[str, str]:
    for alias, command in browser_matches(prefer, require):
        resolved = shutil.which(command)
        if resolved:
            return alias, resolved
    if prefer and require:
        raise SystemExit(f"preferred browser not found: {prefer}")
    raise SystemExit("no supported browser found; install Chrome, Chromium, Brave, Edge, Firefox, or Zen")


def launch_browser(url: str, prefer: str | None = None, new_window: bool = True, require: bool = False) -> dict[str, object]:
    alias, command = find_browser(prefer, require)
    args = [command]
    if new_window:
        args.append("--new-window")
    args.append(url)
    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {
        "browser": alias,
        "command": command,
        "pid": proc.pid,
        "url": url,
        "new_window": new_window,
    }


def browser_cmd(args: argparse.Namespace) -> None:
    result = launch_browser(args.url, args.prefer, not args.same_window, args.require_prefer)
    journal_event("browser", result)
    if args.json:
        stdout_json(result)
    else:
        print(f"opened {result['url']} with {result['browser']} pid={result['pid']}")


def doctor(args: argparse.Namespace) -> None:
    checks = {"version": VERSION, **desktop_state(), "tools": tool_checks()}
    if args.probe:
        probe_path = Path(args.probe_output).expanduser()
        try:
            path = capture_screenshot(str(probe_path), pointer=False)
            checks["screenshot_probe"] = screenshot_summary(path)
        except SystemExit as exc:
            checks["screenshot_probe_error"] = str(exc)
        try:
            uinput_action(lambda ui: ui.move(1, 1))
            checks["uinput_probe"] = True
        except SystemExit as exc:
            checks["uinput_probe_error"] = str(exc)
    if args.json:
        print(json.dumps(checks, indent=2, sort_keys=True))
    else:
        for key, value in checks.items():
            if isinstance(value, dict):
                print(f"{key}:")
                for child_key, child_value in value.items():
                    print(f"  {child_key}: {child_value}")
            else:
                print(f"{key}: {value}")


def perform_input_step(ui: UInput, step: dict[str, object]) -> dict[str, object]:
    action = step_action(step)
    if action == "move":
        ui.move(int(step.get("dx", 0)), int(step.get("dy", 0)))
    elif action == "goto":
        ui.goto(int(step["x"]), int(step["y"]))
    elif action == "click":
        xy = validate_optional_xy(step.get("x"), step.get("y"))
        if xy:
            ui.goto(*xy)
            time.sleep(float(step.get("delay", 0.05)))
        ui.click(str(step.get("button", "left")))
    elif action == "scroll":
        ui.scroll(int(step.get("vertical", 0)), int(step.get("horizontal", 0)))
    elif action == "key":
        ui.tap(key_code(str(step["name"])))
    elif action == "hotkey":
        ui.hotkey([key_code(x) for x in str(step["chord"]).split("+") if x])
    elif action == "type":
        ui.type_text(str(step.get("text", "")))
    else:
        raise ValueError(f"unknown input action: {action}")
    return {"acted": action}


def run_step(step: dict[str, object], output_dir: Path, index: int) -> dict[str, object]:
    action = step_action(step)
    if not action:
        raise ValueError("step is missing action/type")
    if action == "sleep":
        time.sleep(float(step.get("seconds", 0.2)))
        return {"slept": float(step.get("seconds", 0.2))}
    if action == "screenshot":
        output = str(step.get("output") or output_dir / f"step-{index:03d}.png")
        path = capture_screenshot(output, bool(step.get("pointer", False)))
        return {"screenshot": screenshot_summary(path)}
    if action == "observe":
        output = str(step.get("output") or output_dir / f"step-{index:03d}.png")
        return observation(output, bool(step.get("pointer", False)))
    if action == "wait-change":
        output = str(step.get("output") or output_dir / f"step-{index:03d}-changed.png")
        return wait_change(
            float(step.get("timeout", 10)),
            float(step.get("interval", 0.5)),
            output,
            bool(step.get("pointer", False)),
        )
    if action == "open":
        target = str(step["target"])
        subprocess.Popen(["xdg-open", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"opened": target}
    if action == "browser":
        return launch_browser(
            str(step.get("url") or step.get("target") or "about:blank"),
            str(step["prefer"]) if step.get("prefer") else None,
            bool(step.get("new_window", True)),
            bool(step.get("require_prefer", False)),
        )
    if action == "clipboard-set":
        clipboard_set(text_from_step(step))
        return {"clipboard": "set"}
    if action == "paste":
        paste_text(text_from_step(step), bool(step.get("enter", False)))
        return {"pasted": True, "entered": bool(step.get("enter", False))}
    if is_input_step(step):
        result: dict[str, object] = {}
        uinput_action(lambda ui: result.update(perform_input_step(ui, step)))
        return result
    raise ValueError(f"unknown sequence action: {action}")


def sequence_cmd(args: argparse.Namespace) -> None:
    raw = sys.stdin.read() if args.file == "-" else Path(args.file).expanduser().read_text()
    payload = json.loads(raw)
    steps = payload.get("steps", payload) if isinstance(payload, dict) else payload
    if not isinstance(steps, list):
        raise SystemExit("sequence input must be a JSON list or an object with a steps list")
    output_dir = Path(args.output_dir).expanduser().resolve()
    output_dir.mkdir(parents=True, exist_ok=True)
    events: list[dict[str, object]] = []
    ok = True
    ui: UInput | None = None
    for index, step in enumerate(steps):
        if not isinstance(step, dict):
            raise SystemExit(f"sequence step {index} must be an object")
        started = now_ms()
        action = step_action(step)
        event: dict[str, object] = {"index": index, "action": action, "started_ms": started}
        try:
            if is_input_step(step):
                if ui is None:
                    ui = UInput()
                event["result"] = perform_input_step(ui, step)
            else:
                if ui is not None:
                    ui.close()
                    ui = None
                event["result"] = run_step(step, output_dir, index)
            event["ok"] = True
        except SystemExit as exc:
            event["ok"] = False
            event["error"] = str(exc) or "step exited"
            ok = False
        except Exception as exc:  # noqa: BLE001 - command-line tool should serialize failures.
            event["ok"] = False
            event["error"] = str(exc)
            ok = False
        event["duration_ms"] = now_ms() - started
        events.append(event)
        if not event["ok"] and not args.continue_on_error:
            break
    if ui is not None:
        ui.close()
    payload = {"ok": ok, "events": events}
    output = brief_sequence(payload) if args.brief else payload
    emit_json(output, compact=args.compact, brief=args.brief)
    journal_event("sequence", payload)
    if not ok:
        raise SystemExit(1)


